# Cyber Attack Map - Environment Configuration
# Copy this file to .env and configure your keys

# Server Port
PORT=3000

# HoneyDB API Credentials (Free Community Tier)
# Register at: https://honeydb.io/
HONEYDB_API_ID=
HONEYDB_API_KEY=

# OffSeq Mirage Threat Intel API Base URL
OFFSEQ_API_BASE=https://mirage.offseq.com

# Cache TTL in seconds for upstream intelligence feeds
FEED_CACHE_TTL_SECONDS=15

# Default destination sensor cities (comma-separated: Name:lon:lat)
SENSOR_CITIES=Frankfurt:8.6821:50.1109,New York:-74.0060:40.7128,Singapore:103.8198:1.3521,Tokyo:139.6917:35.6895,London:-0.1278:51.5074,Sydney:151.2093:-33.8688,Sao Paulo:-46.6333:-23.5505
